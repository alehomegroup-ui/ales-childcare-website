{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ales-childcare-website",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {},
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/index.js"
}
